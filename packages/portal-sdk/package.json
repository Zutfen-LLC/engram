{
  "name": "engram-portal-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side TypeScript client and generated types for the Engram Control Plane. Server-only; never imported from browser code.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "contracts:generate": "tsx scripts/generate.ts",
    "contracts:check": "tsx scripts/generate.ts --check",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "openapi-typescript": "^7.4.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
