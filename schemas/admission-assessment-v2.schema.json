{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.dev/schemas/admission-assessment-v2.schema.json",
  "title": "Engram risk-aware shadow admission decision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "memory_item_id", "mode", "item_content_hash",
    "policy_profile_key", "policy_contract_version", "policy_config_digest",
    "risk_state", "epistemic_state", "retention_state", "effective_assessment_refs",
    "highest_admission_tier", "surface_decisions", "blocker_codes", "reason_codes",
    "next_actions", "observation_window_hours", "eligible_at", "next_evaluation_at"
  ],
  "properties": {
    "schema_version": {"const": "engram.admission-assessment.v2"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "memory_item_id": {"type": "string", "format": "uuid"},
    "mode": {"const": "shadow"},
    "item_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_profile_key": {"const": "risk_aware_shadow_v1"},
    "policy_contract_version": {"const": "risk-aware-shadow-v1"},
    "policy_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "risk_state": {"enum": ["low", "medium", "high", "unknown", "not_applicable"]},
    "epistemic_state": {
      "enum": ["supported", "contested", "insufficient_evidence", "unknown", "not_applicable"]
    },
    "retention_state": {"enum": ["retain", "transient", "noise", "uncertain", "unknown"]},
    "effective_assessment_refs": {"type": "array", "maxItems": 16},
    "highest_admission_tier": {
      "enum": ["none", "semantic_exploratory", "semantic_governed", "startup"]
    },
    "surface_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_exploratory", "semantic_governed", "startup"],
      "properties": {
        "semantic_exploratory": {"$ref": "#/$defs/surfaceDecision"},
        "semantic_governed": {"$ref": "#/$defs/surfaceDecision"},
        "startup": {"$ref": "#/$defs/surfaceDecision"}
      }
    },
    "blocker_codes": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "reason_codes": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "next_actions": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
    "observation_window_hours": {
      "type": ["integer", "null"], "minimum": 0, "maximum": 8760
    },
    "eligible_at": {"type": ["string", "null"], "format": "date-time"},
    "next_evaluation_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "surfaceDecision": {"enum": ["allow", "withhold", "review_required", "blocked", "unknown"]}
  }
}
