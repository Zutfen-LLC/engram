  "supported_surfaces": ["semantic_exploratory", "semantic_governed", "startup"],
  "assessment_selection": {
    "policy_version": "assessment-selection-v1",
    "accepted_contract_hashes": ["sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],
    "required_purposes": ["combined"]
  },
  "rules": {
    "precedence": [
      "not_live", "conflict", "governance", "risk_high", "risk_unknown",
      "epistemic_contested", "epistemic_insufficient", "qualified"
    ],
    "conditions": {
      "provenance": {"required_assertion_fields": ["assertion_mode", "origin"]},
      "risk": {"known_governed_values": ["low", "medium"], "review_values": ["high", "unknown"]},
      "retention": {"governed_value": "retain"},
      "epistemic": {"governed_value": "supported", "requires_calibrated": true},
      "governance": {"blockers": ["not_live", "conflict", "external_dispute", "human_review"]}
    },
    "observation_windows_hours": {"low": 0, "medium": 72},
    "startup": {
      "new_automatic_admission": false,
      "allow_existing_human_verified": true
    },
    "outputs": {
      "blocked": {"semantic_exploratory": "blocked", "semantic_governed": "blocked", "startup": "blocked"},
      "review_required": {"semantic_exploratory": "allow", "semantic_governed": "review_required", "startup": "review_required"},
      "withhold": {"semantic_exploratory": "allow", "semantic_governed": "withhold", "startup": "withhold"},
      "qualified": {"semantic_exploratory": "allow", "semantic_governed": "allow", "startup": "withhold"}
    }
  }
