{
  "$defs": {
    "Dimensions": {
      "additionalProperties": false,
      "properties": {
        "acceptable_abstention": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Acceptable Abstention",
          "type": "string"
        },
        "assertion_origin": {
          "enum": [
            "direct_user",
            "agent_inference",
            "unknown",
            "unavailable"
          ],
          "title": "Assertion Origin",
          "type": "string"
        },
        "atomic": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Atomic",
          "type": "string"
        },
        "attribution": {
          "enum": [
            "adequate",
            "inadequate",
            "unknown",
            "unavailable",
            "not_applicable"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "conflict_expected": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Conflict Expected",
          "type": "string"
        },
        "consequence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "title": "Consequence",
          "type": "string"
        },
        "dispute_expected": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Dispute Expected",
          "type": "string"
        },
        "epistemic_state": {
          "enum": [
            "adequately_supported",
            "weakly_supported",
            "contradicted",
            "contested",
            "ambiguous",
            "unverifiable",
            "unknown"
          ],
          "title": "Epistemic State",
          "type": "string"
        },
        "evidence_independence": {
          "enum": [
            "known_independent",
            "known_shared_root",
            "unknown"
          ],
          "title": "Evidence Independence",
          "type": "string"
        },
        "evidence_span": {
          "enum": [
            "adequate",
            "inadequate",
            "unknown",
            "unavailable",
            "not_applicable"
          ],
          "title": "Evidence Span",
          "type": "string"
        },
        "expected_blockers": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Blockers"
        },
        "expected_governed_semantic_eligibility": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Expected Governed Semantic Eligibility",
          "type": "string"
        },
        "expected_kind": {
          "enum": [
            "preference",
            "fact",
            "observation",
            "decision",
            "procedure",
            "summary",
            "doctrine",
            "invariant",
            "diary_entry",
            "unknown"
          ],
          "title": "Expected Kind",
          "type": "string"
        },
        "expected_next_action": {
          "enum": [
            "automatic_admission",
            "review",
            "wait",
            "reject",
            "unknown"
          ],
          "title": "Expected Next Action",
          "type": "string"
        },
        "expected_scope": {
          "enum": [
            "private",
            "workspace",
            "tenant",
            "unknown"
          ],
          "title": "Expected Scope",
          "type": "string"
        },
        "expected_startup_eligibility": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Expected Startup Eligibility",
          "type": "string"
        },
        "expected_storage_disposition": {
          "enum": [
            "retain",
            "reject",
            "defer",
            "unknown"
          ],
          "title": "Expected Storage Disposition",
          "type": "string"
        },
        "expected_subject_or_domain": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Expected Subject Or Domain",
          "type": "string"
        },
        "factual_outcome": {
          "anyOf": [
            {
              "enum": [
                "verified_correct",
                "verified_incorrect",
                "became_outdated",
                "not_verifiable",
                "not_yet_known"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Factual Outcome"
        },
        "human_review_required": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Human Review Required",
          "type": "string"
        },
        "proposition_count": {
          "enum": [
            "zero",
            "one",
            "multiple",
            "unknown"
          ],
          "title": "Proposition Count",
          "type": "string"
        },
        "retention_value": {
          "enum": [
            "retain",
            "do_not_retain",
            "uncertain"
          ],
          "title": "Retention Value",
          "type": "string"
        },
        "scope_visibility_concern": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Scope Visibility Concern",
          "type": "string"
        },
        "source_span": {
          "enum": [
            "adequate",
            "inadequate",
            "unknown",
            "unavailable",
            "not_applicable"
          ],
          "title": "Source Span",
          "type": "string"
        },
        "supersession_expected": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Supersession Expected",
          "type": "string"
        },
        "temporal_validity_issue": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Temporal Validity Issue",
          "type": "string"
        }
      },
      "required": [
        "atomic",
        "proposition_count",
        "attribution",
        "source_span",
        "evidence_span",
        "assertion_origin",
        "expected_kind",
        "expected_subject_or_domain",
        "expected_scope",
        "retention_value",
        "epistemic_state",
        "factual_outcome",
        "consequence",
        "expected_storage_disposition",
        "expected_startup_eligibility",
        "expected_governed_semantic_eligibility",
        "human_review_required",
        "acceptable_abstention",
        "conflict_expected",
        "dispute_expected",
        "supersession_expected",
        "temporal_validity_issue",
        "scope_visibility_concern",
        "evidence_independence",
        "expected_blockers",
        "expected_next_action"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "HumanJudgment": {
      "additionalProperties": false,
      "properties": {
        "adjudicated_at": {
          "format": "date-time",
          "title": "Adjudicated At",
          "type": "string"
        },
        "adjudicator_confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "title": "Adjudicator Confidence",
          "type": "string"
        },
        "adjudicator_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Adjudicator Ref",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "reason_code": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "usefulness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usefulness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "adjudicator_ref",
        "adjudicated_at",
        "adjudicator_confidence",
        "reason_code",
        "dimensions"
      ],
      "title": "HumanJudgment",
      "type": "object"
    },
    "Usefulness": {
      "additionalProperties": false,
      "properties": {
        "context_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Context Ref",
          "type": "string"
        },
        "task_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Task Ref",
          "type": "string"
        },
        "useful": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Useful",
          "type": "string"
        }
      },
      "required": [
        "task_ref",
        "context_ref",
        "useful"
      ],
      "title": "Usefulness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^(sha256:)?[0-9a-f]{64}$|^kg-auto-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "dataset_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Dataset Version",
      "type": "string"
    },
    "disagreement": {
      "enum": [
        "none",
        "unresolved",
        "resolved"
      ],
      "title": "Disagreement",
      "type": "string"
    },
    "fixture_role": {
      "enum": [
        "ordinary_claim",
        "stale_claim",
        "incorrect_claim",
        "ambiguous_claim",
        "contested_claim",
        "conflict_peer",
        "distractor",
        "adversarial",
        "non_propositional"
      ],
      "title": "Fixture Role",
      "type": "string"
    },
    "label_origin": {
      "enum": [
        "synthetic_authored",
        "human_adjudicated"
      ],
      "title": "Label Origin",
      "type": "string"
    },
    "label_schema_version": {
      "const": "engram-admission-label-v1",
      "title": "Label Schema Version",
      "type": "string"
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanJudgment"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer_a": {
      "$ref": "#/$defs/HumanJudgment"
    },
    "reviewer_b": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanJudgment"
        },
        {
          "type": "null"
        }
      ]
    },
    "sample_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Sample Id",
      "type": "string"
    },
    "source_sample_ref": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sample Ref"
    }
  },
  "required": [
    "sample_id",
    "label_schema_version",
    "dataset_id",
    "dataset_version",
    "fixture_role",
    "label_origin",
    "reviewer_a",
    "reviewer_b",
    "resolution",
    "disagreement"
  ],
  "title": "LabelRecord",
  "type": "object"
}
